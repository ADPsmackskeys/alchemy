# Copy to .env and uncomment what you need. Values shown are the
# defaults from config.py. Real environment variables win over .env.

# Path to the catalog JSON file
ENTITLEMENT_CATALOG_FILE=entitlement_catalog.json

# Path to the risk scores JSON file
ENTITLEMENT_RISK_SCORES_FILE=entitlement_risk_scores.json

# Bind address for `python main.py`
HOST=127.0.0.1

# Port for `python main.py`
PORT=8001
