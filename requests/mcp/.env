# Copy to .env and uncomment what you need. Values shown are the
# defaults from config.py. Real environment variables win over .env.

# Base URL of the running Requests API
REQUESTS_API_URL=http://127.0.0.1:8000

# Per-request timeout in seconds
REQUESTS_API_TIMEOUT=10

# How the MCP server listens: stdio | http | sse | streamable-http
MCP_TRANSPORT=streamable-http

# Bind address for the MCP server
MCP_HOST=0.0.0.0

# Port for the MCP server
MCP_PORT=8000
