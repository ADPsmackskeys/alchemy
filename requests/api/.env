# Copy to .env and uncomment what you need. Values shown are the
# defaults from config.py. Real environment variables win over .env.

# Postgres connection string. Host port 5433 matches the alchemy docker-compose.
DATABASE_URL=postgresql://alchemy:alchemy@127.0.0.1:5433/alchemy

# Bind address for `python main.py`
HOST=127.0.0.1

# Port for `python main.py`
PORT=8000

# ASGI root_path, for when the API is served behind a path-prefixing proxy
ROOT_PATH=
