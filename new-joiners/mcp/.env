# Copy to .env and uncomment what you need. Values shown are the
# defaults from config.py. Real environment variables win over .env.

# API base URL the MCP server calls
NEW_JOINERS_API_URL=http://127.0.0.1:8000

# MCP server per-request timeout, seconds
NEW_JOINERS_API_TIMEOUT=10

# How mcp_server.py listens: stdio | http | sse | streamable-http
MCP_TRANSPORT=streamable-http

# Bind address for the MCP server
MCP_HOST=0.0.0.0

# Port for the MCP server (same as the API's 8000; run on separate hosts)
MCP_PORT=8000
