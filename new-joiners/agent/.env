# Copy to .env and uncomment what you need. Values shown are the
# defaults from config.py. Real environment variables win over .env.

# Gemini API key. Without it the service starts but /ask returns 503.
GEMINI_API_KEY=AIzaSyC5RbIcP1rHGEk1TPUfqyx0kDNnsQDQ

# Gemini model id -- must be one your key can access
MODEL=gemini-2.5-flash

# 0 keeps answers repeatable
TEMPERATURE=0.0

# Streamable-HTTP endpoint of the new-joiners MCP server
MCP_URL=http://127.0.0.1:8100/mcp

# MCP call timeout, seconds
MCP_TIMEOUT=30

# Tools the agent may call. Every one must be read-only on the server
# or the agent refuses to start.
ALLOWED_TOOLS=list_new_joiners,get_new_joiner,api_health

# Cap on agent steps per question
RECURSION_LIMIT=12

# Bind address and port for `python main.py`
HOST=127.0.0.1
PORT=8200
